# ============================================================
# AI JOB COPILOT — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Database ---
# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ai-job-copilot?retryWrites=true&w=majority

# --- JWT Authentication ---
# Generate with: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- OpenAI API ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o

# --- App Config ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
